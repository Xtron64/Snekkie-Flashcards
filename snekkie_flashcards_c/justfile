_build_silent:
	@make build > /dev/null

build-tests: build
	make build_tests
	@# Old justfile-only solution
	@##!/usr/bin/env bash
	@#set -e
	@#mkdir -p "{\{TESTS_BUILD_DIR}}" "{\{TESTS_COMPILED_DIR}}"
