_build_tests_silent: _build_silent
	@make build_tests > /dev/null

run *args: _build_silent
	./{{TARGET}} {{args}}

run-tests *tests: _build_tests_silent
	#!/usr/bin/env bash
	if [[ -z "{{tests}}" ]]; then
		echo "We don't have a wrapper to run all tests yet"
	else
		for test in {{tests}}; do
			./{{TESTS_COMPILED_DIR}}/$test
		done
	fi

run-valgrind *args: _build_silent
	valgrind ./{{TARGET}} {{args}}

clean:
	make clean
	@# Old justfile-only solution
	@##!/usr/bin/env bash
	@#rm -rf \
	@#	"{\{BUILD_DIR}}" \
	@#	"{\{COMPILED_DIR}}" \
