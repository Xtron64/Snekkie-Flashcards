_docker_up:
	#!/usr/bin/env bash
	if ! docker image inspect "{{DOCKER_IMG}}" > /dev/null 2>&1; then
		echo "BUILDING DOCKER IMAGE"
		just --justfile={{justfile()}} docker-build
	fi

docker-build:
	docker build -t {{DOCKER_IMG}} .

docker-run *args: _docker_up
	docker run -e SNEKKIE_FLASHCARDS_DATA=/data/dummy-safe {{DOCKER_IMG}} {{args}}

docker-run-tests *tests: _docker_up
	#!/usr/bin/env bash
	if [[ -z "{{tests}}" ]]; then
		echo "We don't have a wrapper to run all tests yet"
	else
		for test in {{tests}}; do
			docker run -e SNEKKIE_FLASHCARDS_DATA=/data/dummy-safe \
				--entrypoint "tests-compiled/$test" \
				{{DOCKER_IMG}}
		done
	fi

docker-run-valgrind *args: _docker_up	
	docker run -e SNEKKIE_FLASHCARDS_DATA=/data/dummy-safe \
		--entrypoint "/usr/bin/valgrind" \
		{{DOCKER_IMG}} \
		{{TARGET}} {{args}}

docker-enter: _docker_up
	docker run -it --entrypoint /bin/bash {{DOCKER_IMG}}
	
docker-clean:
	docker rmi -f {{DOCKER_IMG}}
